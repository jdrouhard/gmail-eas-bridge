# Copy to .env and fill in. Never commit the real .env.

# Your full Gmail address.
GMAIL_USER=you@gmail.com

TZ=America/Chicago

# UID/GID that will own everything under the /data bind mount (maildir +
# z-push state), lscr.io-style. Set these to match your host user, e.g.
# `id -u`/`id -g` for whoever should own ./data on the host. Defaults to
# 1000:1000 if unset.
PUID=1000
PGID=1000
