# Copy to .env and fill in. Never commit the real .env.

# Your full Gmail address.
GMAIL_USER=you@gmail.com

# A Gmail App Password (requires 2FA enabled on the Google account):
# https://myaccount.google.com/apppasswords
# Prefer mounting this as a Docker secret instead of an env var where
# possible - see docker-compose.yml.
GMAIL_APP_PASSWORD=

# Password your iPhone (and any other EAS device) will use against
# THIS bridge. Unrelated to your real Gmail password. Pick something
# random and long - store it in your password manager.
ZPUSH_LOCAL_PASSWORD=

TZ=America/Chicago

# UID/GID that will own everything under the /data bind mount (maildir +
# z-push state), lscr.io-style. Set these to match your host user, e.g.
# `id -u`/`id -g` for whoever should own ./data on the host. Defaults to
# 1000:1000 if unset.
PUID=1000
PGID=1000
