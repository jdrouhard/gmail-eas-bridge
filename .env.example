# Copy to .env and fill in. Never commit the real .env.

# Your full Gmail address.
GMAIL_USER=you@gmail.com

TZ=America/Chicago

# UID/GID that will own everything under the /data bind mount (maildir +
# z-push state), lscr.io-style. Set these to match your host user, e.g.
# `id -u`/`id -g` for whoever should own ./data on the host. Defaults to
# 1000:1000 if unset.
PUID=1000
PGID=1000

# How often mbsync runs a full sync regardless of goimapnotify's
# IDLE-triggered syncs - this is what pushes local changes (read
# flags, moves, deletes, sent mail) back to Gmail if the inbox itself
# has been quiet. Standard 5-field cron syntax. Default: top of every
# hour. Use */30 * * * * for every 30 minutes.
MBSYNC_CRON_SCHEDULE="0 * * * *"
